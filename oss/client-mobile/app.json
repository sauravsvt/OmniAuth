{
    "expo": {
        "name": "OmniAuth",
        "slug": "omniauth-mobile",
        "version": "0.1.0",
        "orientation": "portrait",
        "userInterfaceStyle": "automatic",
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.omniauth.mobile"
        },
        "android": {
            "package": "com.omniauth.mobile"
        },
        "plugins": [
            "expo-secure-store"
        ]
    }
}
